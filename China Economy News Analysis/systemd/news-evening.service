[Unit]
Description=China Economy News - Evening Edition Selection
After=network.target

[Service]
Type=oneshot
User=jeozeohan
WorkingDirectory=/home/jeozeohan/vibe_temp/China Economy News Analysis
ExecStart="/home/jeozeohan/vibe_temp/China Economy News Analysis/scripts/run_daily_selection.sh" evening systemd
StandardOutput=append:/home/jeozeohan/vibe_temp/China Economy News Analysis/logs/evening.log
StandardError=append:/home/jeozeohan/vibe_temp/China Economy News Analysis/logs/evening.log
Environment=HOME=/home/jeozeohan
Restart=on-failure
RestartSec=60
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
