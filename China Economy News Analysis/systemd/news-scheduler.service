[Unit]
Description=China Economy News - Scheduler Daemon (crawl + enrich + analyze)
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=jeozeohan
WorkingDirectory=/home/jeozeohan/vibe_temp/China Economy News Analysis
ExecStart=/usr/bin/python3 src/agents/scheduler_agent.py
StandardOutput=append:/home/jeozeohan/vibe_temp/China Economy News Analysis/logs/scheduler.log
StandardError=append:/home/jeozeohan/vibe_temp/China Economy News Analysis/logs/scheduler.log
Environment=HOME=/home/jeozeohan
EnvironmentFile=/home/jeozeohan/vibe_temp/China Economy News Analysis/.env
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
