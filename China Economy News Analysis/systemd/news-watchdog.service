[Unit]
Description=China Economy News - Watchdog Health Check
After=network.target

[Service]
Type=oneshot
User=jeozeohan
WorkingDirectory=/home/jeozeohan/vibe_temp/China Economy News Analysis
ExecStart=/usr/bin/python3 monitoring/watchdog.py
StandardOutput=append:/home/jeozeohan/vibe_temp/China Economy News Analysis/logs/watchdog.log
StandardError=append:/home/jeozeohan/vibe_temp/China Economy News Analysis/logs/watchdog.log
Environment=HOME=/home/jeozeohan
EnvironmentFile=/home/jeozeohan/vibe_temp/China Economy News Analysis/.env

[Install]
WantedBy=multi-user.target
