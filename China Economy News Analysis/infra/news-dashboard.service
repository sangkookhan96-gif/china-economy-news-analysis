[Unit]
Description=China Economy News - Expert Dashboard (Streamlit, port 8501)
After=network.target ollama.service

[Service]
Type=simple
User=jeozeohan
WorkingDirectory=/home/jeozeohan/vibe_temp/China Economy News Analysis
ExecStart=/usr/bin/python3 -m streamlit run src/ui/expert_dashboard.py --server.port 8501 --server.headless true --server.address 0.0.0.0
StandardOutput=append:/home/jeozeohan/vibe_temp/China Economy News Analysis/logs/dashboard.log
StandardError=append:/home/jeozeohan/vibe_temp/China Economy News Analysis/logs/dashboard.log
Environment=HOME=/home/jeozeohan
Environment=PYTHONPATH=/home/jeozeohan/.local/lib/python3.10/site-packages
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
